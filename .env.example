# Copy this file to .env and fill in your keys.
# I put .env in .gitignore, so these secrets never go to GitHub.

# PayPal sandbox: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret
PAYPAL_ENV=sandbox

# Google Gemini (free key): aistudio.google.com > Get API key
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite   (falls back to gemini-3.6-flash when busy)

PORT=3000
