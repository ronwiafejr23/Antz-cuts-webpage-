# Copy this file to .env and paste your PayPal sandbox keys.
# .env is in .gitignore, so your secret never goes to GitHub.
# Get keys at developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret
PAYPAL_ENV=sandbox
PORT=3000
